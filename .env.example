# Terminal 3 testnet API key — self-serve from https://www.terminal3.io/claim-page
# (shown once; store it in a password manager, never commit it)
T3N_API_KEY=

# testnet | sandbox (alias of testnet) | production
T3N_ENVIRONMENT=testnet

# Local demo mode: 1 = in-memory backend, no network calls (default for `npm run demo`)
PASSPORT_DEMO_MODE=1
